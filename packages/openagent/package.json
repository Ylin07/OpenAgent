{
  "$schema": "https://json.schemastore.org/package.json",
  "version": "1.16.2",
  "name": "openagent",
  "type": "module",
  "license": "MIT",
  "private": true,
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test": "bun test src",
    "test:ci": "mkdir -p .artifacts/unit && bun test --reporter=junit --reporter-outfile=.artifacts/unit/junit.xml src",
    "build": "bun run script/build.ts",
    "dev": "bun run --conditions=browser ./src/index.ts"
  },
  "bin": {
    "openagent": "./bin/openagent"
  },
  "exports": {
    "./*": "./src/*.ts"
  },
  "imports": {
    "#db": {
      "bun": "./src/storage/db.bun.ts",
      "node": "./src/storage/db.node.ts",
      "default": "./src/storage/db.bun.ts"
    }
  },
  "devDependencies": {
    "@openagent-ai/core": "workspace:*",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/cross-spawn": "catalog:",
    "@types/mime-types": "3.0.1",
    "@types/npm-package-arg": "6.1.4",
    "@types/semver": "^7.5.8",
    "@types/turndown": "5.0.5",
    "@types/yargs": "17.0.33",
    "@typescript/native-preview": "catalog:",
    "vscode-languageserver-types": "3.17.5"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "0.21.0",
    "@ai-sdk/openai-compatible": "2.0.41",
    "@ai-sdk/provider": "3.0.8",
    "@clack/prompts": "1.0.0-alpha.1",
    "@effect/opentelemetry": "catalog:",
    "@effect/platform-node": "catalog:",
    "@modelcontextprotocol/sdk": "1.27.1",
    "@openagent-ai/llm": "workspace:*",
    "@openagent-ai/plugin": "workspace:*",
    "@openagent-ai/sdk": "workspace:*",
    "@openagent-ai/server": "workspace:*",
    "@opentui/core": "catalog:",
    "@opentui/keymap": "catalog:",
    "@opentui/solid": "catalog:",
    "@silvia-odwyer/photon-node": "0.3.4",
    "@solid-primitives/event-bus": "1.1.3",
    "@solid-primitives/scheduled": "1.5.2",
    "@xterm/headless": "6.0.0",
    "ai": "catalog:",
    "clipboardy": "4.0.0",
    "cross-spawn": "catalog:",
    "decimal.js": "10.5.0",
    "diff": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "fuzzysort": "3.1.0",
    "mime-types": "3.0.2",
    "htmlparser2": "8.0.2",
    "jsonc-parser": "3.3.1",
    "npm-package-arg": "13.0.2",
    "open": "10.1.2",
    "opentui-spinner": "catalog:",
    "remeda": "catalog:",
    "semver": "^7.6.3",
    "solid-js": "catalog:",
    "strip-ansi": "7.1.2",
    "tree-sitter-bash": "0.25.0",
    "tree-sitter-powershell": "0.25.10",
    "turndown": "7.2.0",
    "ulid": "catalog:",
    "vscode-jsonrpc": "8.2.1",
    "web-tree-sitter": "0.25.10",
    "yargs": "18.0.0",
    "zod": "catalog:"
  },
  "overrides": {
    "drizzle-orm": "catalog:"
  }
}
